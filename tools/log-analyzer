#!/usr/bin/env python3
import argparse
import re
from collections import defaultdict

CHECK_BRACKET_RE = re.compile(r"\[([A-Za-z]+)\]\s+P:")
BUFFER_RE = re.compile(r"(?:Buffer:|buffer=)(-?\d+(?:\.\d+)?)")
LABEL_RE = re.compile(r"label=(fp|tp|fn)")
DELAY_RE = re.compile(r"delay_ms=(\d+(?:\.\d+)?)")
STATE_KEYS = ("pending=", "onGround=", "sprint=", "dirStable=", "flags=", "source=")


def infer_check(payload: str) -> str:
    m = CHECK_BRACKET_RE.search(payload)
    if m:
        return m.group(1)
    if "Velocity txWindow" in payload or "Velocity DELAYED_KB_PATTERN" in payload:
        return "Velocity"
    if "Speed h=" in payload:
        return "Speed"
    if "Ray-Distance" in payload:
        return "Reach"
    if "checks SKIPPED" in payload:
        return "SKIPPED"
    return "UNKNOWN"


def extract_state(payload: str) -> str:
    states = []
    for key in STATE_KEYS:
        idx = payload.find(key)
        if idx >= 0:
            end = payload.find(" ", idx)
            states.append(payload[idx:] if end == -1 else payload[idx:end])
    return ",".join(states) if states else "-"


def parse(path: str):
    stats = defaultdict(lambda: {
        "total": 0,
        "fp": 0,
        "states": defaultdict(int),
        "buffers": [],
        "delays": []
    })
    regression = {"fp": 0, "fn": 0, "delays": []}

    with open(path, "r", encoding="utf-8", errors="ignore") as fh:
        for line in fh:
            if "[REGRESSION]" in line:
                lm = LABEL_RE.search(line)
                if lm:
                    if lm.group(1) == "fp":
                        regression["fp"] += 1
                    elif lm.group(1) == "fn":
                        regression["fn"] += 1
                dm = DELAY_RE.search(line)
                if dm:
                    regression["delays"].append(float(dm.group(1)))
                continue

            if "[GLAC-DEBUG]" not in line:
                continue
            payload = line.split("[GLAC-DEBUG]", 1)[1].strip()
            check = infer_check(payload)
            entry = stats[check]
            entry["total"] += 1

            label_match = LABEL_RE.search(payload)
            if label_match and label_match.group(1) == "fp":
                entry["fp"] += 1
                regression["fp"] += 1
            elif label_match and label_match.group(1) == "fn":
                regression["fn"] += 1

            state = extract_state(payload)
            entry["states"][state] += 1

            bm = BUFFER_RE.search(payload)
            if bm:
                entry["buffers"].append(float(bm.group(1)))

            dm = DELAY_RE.search(payload)
            if dm:
                delay = float(dm.group(1))
                entry["delays"].append(delay)
                regression["delays"].append(delay)

    return stats, regression


def avg_positive_growth(values):
    if len(values) < 2:
        return 0.0
    growth = []
    for i in range(1, len(values)):
        d = values[i] - values[i - 1]
        if d > 0:
            growth.append(d)
    return sum(growth) / len(growth) if growth else 0.0


def main():
    ap = argparse.ArgumentParser(description="Analyze [GLAC-DEBUG] logs for check quality metrics")
    ap.add_argument("logfile", help="Path to server log")
    args = ap.parse_args()

    stats, regression = parse(args.logfile)

    print("=== Check metrics ===")
    print("check\ttotal\tfp\tfp_rate\tpre_trigger_state\tavg_buffer_growth")
    for check in sorted(stats.keys()):
        s = stats[check]
        fp_rate = (s["fp"] / s["total"]) if s["total"] else 0.0
        state = max(s["states"], key=s["states"].get) if s["states"] else "-"
        growth = avg_positive_growth(s["buffers"])
        print(f"{check}\t{s['total']}\t{s['fp']}\t{fp_rate:.2%}\t{state}\t{growth:.4f}")

    avg_delay = (sum(regression["delays"]) / len(regression["delays"])) if regression["delays"] else 0.0
    print("\n=== Regression gate metrics ===")
    print(f"误判数量={regression['fp']}")
    print(f"漏判数量={regression['fn']}")
    print(f"平均触发延迟={avg_delay:.2f}ms")


if __name__ == "__main__":
    main()
